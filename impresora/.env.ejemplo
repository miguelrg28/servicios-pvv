# El mismo secreto que lleva el panel en IMPRESORA_TOKEN. Mínimo 20 caracteres: con menos, el
# servicio responde 503 y no imprime nada — una variable olvidada cierra la puerta, no la abre.
IMPRESORA_TOKEN=

# Dónde está SumatraPDF. Si se deja en esta misma carpeta como SumatraPDF.exe, no hace falta.
# SUMATRA_EXE=C:\servicios-pvv\impresora\SumatraPDF.exe

# Dónde escucha. Lo normal: la IP de ZeroTier de ESTE equipo (zerotier-cli info), para que el
# puerto quede cerrado a la red local. Vacío = 0.0.0.0 (todas las redes del equipo).
IMPRESORA_ESCUCHAR=
IMPRESORA_PUERTO=8766
